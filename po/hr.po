msgstr "Dodana je opcija za kopiranje cijele palete"

#: data/com.jeffser.Pigment.metainfo.xml.in:103
msgid "Added option to capitalize colors"
msgstr "Dodana je opcija za pisanje boja velikim slovima"

#: data/com.jeffser.Pigment.metainfo.xml.in:104
msgid "Better metadata for distribution"
msgstr "Bolji metapodaci za distribuciju"

#: data/com.jeffser.Pigment.metainfo.xml.in:110
msgid "New icon"
msgstr "Nova ikona"

#: data/com.jeffser.Pigment.metainfo.xml.in:111
msgid "Removed unnecessary permissions to access network"
msgstr "Uklonjene su nepotrebne dozvole za pristup mreži"

#: data/com.jeffser.Pigment.metainfo.xml.in:112
msgid "Added translation to spanish"
msgstr "Dodan je prijevod za španjolski"

#: data/com.jeffser.Pigment.metainfo.xml.in:118
